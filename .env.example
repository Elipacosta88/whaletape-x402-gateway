# Copy to .env and fill in. NEVER put a private key or a seed phrase here:
# every value below is a PUBLIC address or a public endpoint.
#
# Rule enforced by the code: a network with no receiving address does not
# exist. It is not registered on the server and it never appears in the 402.
# That is deliberate -- the 402 must not advertise a network the server
# cannot verify.

# ----- Base (required) -----------------------------------------------------
# Public address that receives payments. Without it the server refuses to boot.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
# Default if unset is eip155:84532 (Base Sepolia, testnet), on purpose.
NETWORK=eip155:8453

# ----- Solana --------------------------------------------------------------
PAY_TO_SOLANA=
SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# ----- Arbitrum One --------------------------------------------------------
PAY_TO_ARBITRUM=
ARBITRUM_NETWORK=eip155:42161

# ----- Robinhood Chain (USDG, settled by Naven) ----------------------------
PAY_TO_ROBINHOOD=
ROBINHOOD_NETWORK=eip155:4663
NAVEN_FACILITATOR_URL=https://facilitator.naven.network

# ----- Algorand ------------------------------------------------------------
# Algorand runs in a SEPARATE process (see the "Algorand" section of README.md): the AVM scheme lives
# in the `x402-avm` distribution, which shadows the `x402` package and must
# never be installed in this venv.
PAY_TO_ALGORAND=
ALGORAND_NETWORK=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
ALGORAND_USDC_ASA=31566704
ALGORAND_FEE_PAYER=
# Empty = the Algorand option is built locally, for DEMONSTRATION ONLY (this
# process cannot verify or settle an Algorand payment). Set it to the AVM
# gateway to advertise and settle for real.
# The base URL of YOUR AVM gateway, e.g. http://127.0.0.1:8080 -- there is no
# meaningful default, and the placeholder in caixa_algorand.py is never used
# while this stays empty.
ALGORAND_GATEWAY_URL=

# ----- Facilitators --------------------------------------------------------
# Explicit primary facilitator, for a deployment with no CDP credentials
# (e.g. https://facilitator.payai.network, which serves Base and Arbitrum One
# without authentication but does NOT cover Solana). When set, it wins over CDP.
FACILITATOR_URL=
# Without CDP credentials and without the override, the server uses the free
# public testnet facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Fallback behind CDP, Base and Arbitrum only. Empty disables the failover.
FACILITATOR_RESERVA_URL=https://facilitator.payai.network

# ----- Serving -------------------------------------------------------------
SITE=https://whaletape.xyz
BIND_HOST=127.0.0.1
PORT=8402
# Which network the client sees FIRST in `accepts`. Most x402 clients pay the
# first offer they understand, so this decides the network of the sale.
X402_REDE_PRIMEIRA=solana
